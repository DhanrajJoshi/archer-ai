{
  "name": "archer-ai",
  "version": "1.0.0",
  "description": "ARCHER AI — ADK-powered mobile AI agent operating system with multi-agent workflows, skills, tools, memory, and real-time execution.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm run start",
    "test": "npm run type-check",
    "type-check": "npm run type-check:backend && npm run type-check:frontend",
    "type-check:backend": "cd backend && npm run type-check",
    "type-check:frontend": "cd frontend && npm run type-check"
  },
  "keywords": [
    "ai-agent",
    "multi-agent",
    "adk",
    "google-adk",
    "mobile",
    "workflows",
    "agent-orchestration"
  ],
  "author": "DhanrajJoshi",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ]
}
